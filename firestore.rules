rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ───────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // Funciona porque corrigimos os documentos de usuário para usar UID como ID
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    function isGestor() {
      return isAuth() && perfil() == "gestor";
    }

    function isUsuario() {
      return isAuth() && perfil() == "usuario";
    }

    function isConsulta() {
      return isAuth() && perfil() == "consulta";
    }

    // Perfil de fiscalização: leitura ampla (auditoria + relatórios), nenhuma escrita.
    function isAuditor() {
      return isAuth() && perfil() == "auditor";
    }

    // ─── período de reserva ────────────────────────────────────────────────
    // Guarda contra período absurdo. Em teste de uso real um usuário conseguiu
    // reservar um veículo por ~100 anos — os dois campos de data eram independentes
    // e nada limitava a duração.
    //
    // A duração exata (7 dias) é validada no cliente (src/utils/periodo.ts): as datas
    // são gravadas como texto ISO e a regra não faz aritmética de data sobre string.
    // O que a regra garante é o limite ABSOLUTO — nenhuma data mais de 2 anos à frente.
    // Isso mata o caso do ano digitado errado (2026 → 2126), que foi a falha real.
    //
    // A comparação de texto funciona porque o formato ISO ("AAAA-MM-DDTHH:MM") ordena
    // lexicograficamente na mesma ordem cronológica.
    function dataDentroDoHorizonte(valor) {
      return valor is string
        && valor.size() >= 16
        && valor < string(request.time.year() + 2) + "-01-01T00:00";
    }

    function periodoSao(inicio, fim) {
      return dataDentroDoHorizonte(inicio) && dataDentroDoHorizonte(fim) && fim > inicio;
    }

    // ─── solicitacoesAcesso ────────────────────────────────────────────────
    // Qualquer pessoa pode submeter o formulário público de pré-cadastro.
    // Somente gestores gerenciam (leem/atualizam).
    // Guarda de forma (defesa em profundidade, além do App Check): exige os campos
    // obrigatórios presentes, status inicial "pendente" e tamanhos máximos sãos —
    // rejeita escrita malformada/gigante mesmo que um token de App Check falhe/falte.
    function solicitacaoAcessoValida() {
      let d = request.resource.data;
      return d.status == "pendente"
        && d.keys().hasOnly([
          "nomeCompleto","email","matricula","setor","numeroCnh","vencimentoCnh",
          "numeroDiario","dataPublicacao","numeroResolucao","status","criadoEm"
        ])
        && d.nomeCompleto is string && d.nomeCompleto.size() > 0 && d.nomeCompleto.size() < 200
        && d.email is string && d.email.size() > 0 && d.email.size() < 200
        && d.matricula is string && d.matricula.size() < 60
        && d.setor is string && d.setor.size() < 200
        && d.numeroCnh is string && d.numeroCnh.size() < 60
        && d.vencimentoCnh is string && d.vencimentoCnh.size() < 40
        && d.numeroDiario is string && d.numeroDiario.size() < 60
        && d.dataPublicacao is string && d.dataPublicacao.size() < 40
        && d.numeroResolucao is string && d.numeroResolucao.size() < 60;
    }
    match /solicitacoesAcesso/{id} {
      allow create: if solicitacaoAcessoValida();
      allow read, update: if isGestor();
      allow delete: if false;
    }

    // ─── setores ────────────────────────────────────────────────────────────
    // Catálogo de setores da CGE-MS. Leitura pública (formulário de solicitação
    // de acesso, antes do login, também precisa listar); só gestor escreve.
    match /setores/{id} {
      allow read: if true;
      allow write: if isGestor();
    }

    // ─── veiculos ─────────────────────────────────────────────────────────
    // Gestor e usuário consultam; consulta não vê (só os calendários públicos/mirror).
    // Auditor lê (relatórios/fiscalização), nunca escreve.
    // Escrita: só o gestor cadastra/edita o veículo inteiro. O usuário escreve apenas
    // os campos status/kmAtual (Checkout/Checkin ao retirar/devolver) — antes a regra
    // permitia ao usuario reescrever o documento inteiro (placa, marca, modelo...),
    // brecha fechada na auditoria de 2026-07-19. Ninguém deleta veículo.
    match /veiculos/{id} {
      allow read: if isGestor() || isUsuario() || isAuditor();
      allow create: if isGestor();
      allow update: if isGestor()
        || (isUsuario()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","kmAtual"]));
      allow delete: if false;
    }

    // ─── calendarioPublico ────────────────────────────────────────────────
    // Coleção com apenas campos não-sensíveis para exibição pública.
    // Campos: veiculoPlaca, dataSaida, dataRetorno, status, condutorId (sem condutorNome,
    // destino, motivo — condutorId não é PII, é só o uid usado para escopar a escrita).
    // Leitura livre a qualquer pessoa (inclusive perfil consulta). Escrita: gestor tem acesso
    // total; usuario só pode escrever/apagar o próprio evento (dono da solicitação) — fechado
    // em 2026-08-02, antes qualquer usuario podia alterar/apagar o evento de outro (vandalismo
    // no calendário público, sem exposição de dado sensível).
    match /calendarioPublico/{id} {
      allow read: if true;
      allow create: if isGestor()
        || (isUsuario() && request.resource.data.condutorId == request.auth.uid);
      allow update, delete: if isGestor()
        || (isUsuario() && resource.data.condutorId == request.auth.uid);
    }

    // ─── calendarioPublicoSalas ─────────────────────────────────────────────
    // Mesmo padrão de 'calendarioPublico', mirror não-sensível de 'reservasSalas'
    // pra exibir o calendário de salas também na tela de login (pré-autenticação).
    // Campos: salaNome, dataInicio, dataFim, status, responsavelId (sem responsavelNome, motivo).
    // Mesma correção de escopo de escrita de 2026-08-02.
    match /calendarioPublicoSalas/{id} {
      allow read: if true;
      allow create: if isGestor()
        || (isUsuario() && request.resource.data.responsavelId == request.auth.uid);
      allow update, delete: if isGestor()
        || (isUsuario() && resource.data.responsavelId == request.auth.uid);
    }

    // ─── solicitacoes ──────────────────────────────────────────────────────
    // Leitura restrita a gestor, ou ao próprio dono da solicitação (LGPD: condutorNome,
    // destino, motivo são sensíveis — um usuario não pode mais ler solicitações de outros
    // condutores; a checagem de conflito de horário em Solicitar.tsx lê do mirror não-sensível
    // 'calendarioPublico' em vez desta coleção, ver PLANO.md Fase 5).
    // Perfil consulta não lê esta coleção — só o mirror público em 'calendarioPublico'.
    match /solicitacoes/{id} {
      allow read: if isGestor() || isAuditor() || (isUsuario() && resource.data.condutorId == request.auth.uid);

      // Usuário cria apenas as próprias solicitações, com período dentro do horizonte
      allow create: if isUsuario()
        && request.resource.data.condutorId == request.auth.uid
        && periodoSao(request.resource.data.dataSaida, request.resource.data.dataRetorno);

      // Gestor aprova/recusa; usuário cancela a própria solicitação pendente
      allow update: if isGestor()
        || (isUsuario()
            && resource.data.condutorId == request.auth.uid
            && resource.data.status == "pendente"
            && request.resource.data.status == "cancelada");

      // Checkout/checkin: usuário atualiza status de aprovada → em_uso → concluida
      allow update: if isUsuario()
        && resource.data.condutorId == request.auth.uid
        && resource.data.status in ["aprovada", "em_uso"];

      allow delete: if false;
    }

    // ─── usuarios ─────────────────────────────────────────────────────────
    // Documento ID = Firebase Auth UID (obrigatório após a correção do addDoc).
    // Cada conta lê apenas o próprio perfil; gestor e auditor leem todos.
    // Auto-update: o próprio usuário pode atualizar seu doc, MAS NUNCA os campos
    // 'perfil' e 'ativo' — sem essa trava, qualquer conta gravava { perfil: "gestor" }
    // em si mesma e se autopromovia (achado crítico da auditoria de 2026-07-19).
    // Só o gestor muda perfil/ativo de qualquer conta.
    match /usuarios/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isGestor() || isAuditor());
      allow create: if isGestor();
      allow update: if isGestor()
        || (request.auth.uid == uid
            && request.resource.data.perfil == resource.data.perfil
            && request.resource.data.ativo  == resource.data.ativo);
      allow delete: if false;
    }

    // ─── manutencoes ──────────────────────────────────────────────────────
    match /manutencoes/{id} {
      allow read: if isGestor() || isUsuario() || isAuditor();
      allow write: if isGestor();
    }

    // ─── usos (checkout / checkin) ────────────────────────────────────────
    // Leitura restrita a gestor, ou ao próprio dono do registro (mesma decisão de LGPD
    // aplicada a 'solicitacoes' acima). Checkin.tsx sempre inclui o filtro condutorId
    // na query, exigido pelo Firestore para queries multi-documento sob esta regra.
    match /usos/{id} {
      allow read: if isGestor() || isAuditor() || (isUsuario() && resource.data.condutorId == request.auth.uid);
      allow create: if isUsuario();
      allow update: if isUsuario()
        && resource.data.condutorId == request.auth.uid;
      allow delete: if false;
    }

    // ─── auditoria ────────────────────────────────────────────────────────
    // Append-only: create permitido para quem opera a frota; update/delete proibido.
    // Autoria travada — quem grava só pode registrar a ação como própria
    // (usuarioId == uid), senão o log aceitaria atribuir uma ação a outra pessoa
    // (achado da auditoria de 2026-07-19). Gestor e auditor leem o log.
    match /auditoria/{id} {
      allow read: if isGestor() || isAuditor();
      allow create: if (isGestor() || isUsuario())
        && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── salas ────────────────────────────────────────────────────────────
    // Cadastro de salas de reunião. Todo perfil autenticado lê (inclusive consulta,
    // que só enxerga calendários); só gestor cadastra/edita.
    match /salas/{id} {
      allow read: if isGestor() || isUsuario() || isConsulta();
      allow write: if isGestor();
    }

    // ─── reservasSalas ──────────────────────────────────────────────────────
    // Reserva auto-confirmada (sem fila de aprovação, decisão do projeto).
    // Mesma visibilidade de 'salas': todo perfil autenticado lê.
    match /reservasSalas/{id} {
      allow read: if isGestor() || isUsuario() || isConsulta();

      // Gestor e usuário reservam para si mesmos (sala é recurso compartilhado por todo mundo, não só condutores)
      allow create: if (isGestor() || isUsuario())
        && request.resource.data.responsavelId == request.auth.uid
        && periodoSao(request.resource.data.dataInicio, request.resource.data.dataFim);

      // Qualquer um dos dois cancela a própria reserva; gestor cancela qualquer uma
      allow update: if isGestor()
        || ((isGestor() || isUsuario()) && resource.data.responsavelId == request.auth.uid);

      allow delete: if false;
    }

    // ─── veiculosProprios ───────────────────────────────────────────────────
    // Anexo I do Decreto 10.154/2000 — Termo de Opção e Cadastramento de Veículo.
    // Cadastro único por servidor; dado sensível (dados do veículo particular), gestor e o próprio dono leem.
    match /veiculosProprios/{id} {
      allow read: if isGestor() || (isUsuario() && resource.data.servidorId == request.auth.uid);
      allow create: if isUsuario() && request.resource.data.servidorId == request.auth.uid;
      allow update: if isGestor() || (isUsuario() && resource.data.servidorId == request.auth.uid);
      allow delete: if false;
    }

    // ─── indenizacoes ───────────────────────────────────────────────────────
    // Anexo II do Decreto 10.154/2000 — Boletim Demonstrativo de Viagem e Homologação.
    // Uma por deslocamento; mesma visibilidade de veiculosProprios (dado financeiro/pessoal sensível).
    match /indenizacoes/{id} {
      allow read: if isGestor() || (isUsuario() && resource.data.servidorId == request.auth.uid);
      allow create: if isUsuario() && request.resource.data.servidorId == request.auth.uid;
      allow update: if isGestor() || (isUsuario() && resource.data.servidorId == request.auth.uid);
      allow delete: if false;
    }

    // ─── configuracoes ──────────────────────────────────────────────────────
    // Valores paramétricos editáveis pelo gestor sem precisar de deploy de código
    // (ex.: valor do km da indenização de transporte, Decreto 10.154/2000 — reajustado
    // por decreto de tempos em tempos). Leitura: gestor e usuário (o usuário precisa do
    // valor pra calcular o Anexo II ao preencher o formulário). Escrita: só gestor.
    match /configuracoes/{id} {
      allow read: if isGestor() || isUsuario();
      allow write: if isGestor();
    }

    // ─── equipamentos ───────────────────────────────────────────────────────
    // Catálogo com patrimônio individual (notebooks, projetores, etc).
    // Só o gestor cadastra/edita o item inteiro. O usuário escreve apenas o campo
    // status (ao reservar/retirar/devolver/cancelar) — mesma brecha de 'veiculos'
    // fechada na auditoria de 2026-07-19.
    match /equipamentos/{id} {
      allow read: if isGestor() || isUsuario() || isConsulta();
      allow create: if isGestor();
      allow update: if isGestor()
        || (isUsuario()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]));
      allow delete: if false;
    }

    // ─── emprestimosEquipamentos ────────────────────────────────────────────
    // Empréstimo auto-confirmado (mesmo padrão de reservasSalas, sem fila de aprovação).
    match /emprestimosEquipamentos/{id} {
      allow read: if isGestor() || isUsuario() || isConsulta();

      allow create: if (isGestor() || isUsuario())
        && request.resource.data.responsavelId == request.auth.uid
        && periodoSao(request.resource.data.dataInicio, request.resource.data.dataFim);

      // Dono do empréstimo avança o próprio status (retirar/devolver/cancelar); gestor mexe em qualquer um
      allow update: if isGestor()
        || ((isGestor() || isUsuario()) && resource.data.responsavelId == request.auth.uid);

      allow delete: if false;
    }
  }
}
